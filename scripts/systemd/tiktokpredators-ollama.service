[Unit]
Description=Generate private TikTokPredators case evidence reports
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@WEBROOT@
Environment="EVIDENCE_PRIVATE_STORAGE_PATH=@STORAGE@"
EnvironmentFile=-/etc/tiktokpredators/ollama-worker.env
ExecStart=/usr/bin/env php -d memory_limit=512M @WEBROOT@/scripts/ollama-worker.php
TimeoutStartSec=infinity
UMask=0077
Nice=10
PrivateTmp=true
NoNewPrivileges=true
